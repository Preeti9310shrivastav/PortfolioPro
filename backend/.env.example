# Django Application Configuration
SECRET_KEY=django-insecure-portfoliopro-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Supabase PostgreSQL Connection String
# Port 5432: Direct connection (recommended for running Django migrations)
# Port 6543: Supavisor connection pooler (recommended for high-concurrency API server on Render)
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# CORS Whitelist (Front-end origins allowed to call the API)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://portfoliopro.netlify.app

# JWT Token Lifespans
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1
